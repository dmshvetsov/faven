{
  "name": "admin-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Administrative CLI for Faven.",
  "type": "module",
  "bin": {
    "faven": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "faven",
    "admin",
    "cli"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@solana/kit": "^5.1.0",
    "sdk": "workspace:*"
  }
}
