// Creates the local Markets used by the RFQ server.

addon "svm" {
    rpc_api_url = input.rpc_api_url
    network_id = input.network_id
}

variable "options_program" {
    value = svm::get_program_from_anchor_project("options")
}

variable "wsol_market" {
    value = svm::find_pda(
        "FAVENgBXzD9K9qYHKRF5RFRJeT4Qa2EV4EoTycki5gGT",
        [
            "market", "PythTwap",
            std::decode_hex("ef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d"),
            std::decode_base58("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"),
            std::decode_base58("So11111111111111111111111111111111111111112"),
            std::decode_base58(signer.operator.public_key),
        ]
    )
}

variable "pump_market" {
    value = svm::find_pda(
        "FAVENgBXzD9K9qYHKRF5RFRJeT4Qa2EV4EoTycki5gGT",
        [
            "market", "PythTwap",
            std::decode_hex("7a01fca212788bba7c5bf8c9efd576a8a722f070d2c17596ff7bb609b8d5c3b9"),
            std::decode_base58("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"),
            std::decode_base58("pumpCmXqMfrsAkQ5r49WcJnRayYRqmXz6ae8H7H9Dfn"),
            std::decode_base58(signer.operator.public_key),
        ]
    )
}

variable "spcx_market" {
    value = svm::find_pda(
        "FAVENgBXzD9K9qYHKRF5RFRJeT4Qa2EV4EoTycki5gGT",
        [
            "market", "PythTwap",
            std::decode_hex("e8e2234a06b288fedde43ae9450cb288886ecb3259ad2f41d0067f02244a0101"),
            std::decode_base58("EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"),
            std::decode_base58("SPCXxcqXj6e5dJDVNovHN8744zkbhM2bYudU45BimGb"),
            std::decode_base58(signer.operator.public_key),
        ]
    )
}

action "create_wsol_usdc_market" "svm::process_instructions" {
    description = "Create the SOL / USDC / wSOL Market"
    instruction {
        program_idl = variable.options_program.idl
        instruction_name = "create_market"
        instruction_args = [{ "PythTwap" = { "feed_id" = std::decode_hex("ef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d") } }, 2000000, 200, 1500]
        payer { public_key = signer.operator.public_key }
        operator { public_key = signer.operator.public_key }
        quote_mint { public_key = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v" }
        base_mint { public_key = "So11111111111111111111111111111111111111112" }
        market { public_key = variable.wsol_market.pda }
        quote_token_program { public_key = "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA" }
        base_token_program { public_key = "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA" }
        system_program { public_key = std::decode_base58("11111111111111111111111111111111") }
    }
    signers = [signer.operator]
}

action "create_pump_usdc_market" "svm::process_instructions" {
    description = "Create the PUMP / USDC / PUMP Market"
    instruction {
        program_idl = variable.options_program.idl
        instruction_name = "create_market"
        instruction_args = [{ "PythTwap" = { "feed_id" = std::decode_hex("7a01fca212788bba7c5bf8c9efd576a8a722f070d2c17596ff7bb609b8d5c3b9") } }, 2000000, 200, 1500]
        payer { public_key = signer.operator.public_key }
        operator { public_key = signer.operator.public_key }
        quote_mint { public_key = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v" }
        base_mint { public_key = "pumpCmXqMfrsAkQ5r49WcJnRayYRqmXz6ae8H7H9Dfn" }
        market { public_key = variable.pump_market.pda }
        quote_token_program { public_key = "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA" }
        base_token_program { public_key = "TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb" }
        system_program { public_key = std::decode_base58("11111111111111111111111111111111") }
    }
    signers = [signer.operator]
}

action "create_spcx_usdc_market" "svm::process_instructions" {
    description = "Create the SPCX / USDC / SPCX Market"
    instruction {
        program_idl = variable.options_program.idl
        instruction_name = "create_market"
        instruction_args = [{ "PythTwap" = { "feed_id" = std::decode_hex("e8e2234a06b288fedde43ae9450cb288886ecb3259ad2f41d0067f02244a0101") } }, 2000000, 200, 1500]
        payer { public_key = signer.operator.public_key }
        operator { public_key = signer.operator.public_key }
        quote_mint { public_key = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v" }
        base_mint { public_key = "SPCXxcqXj6e5dJDVNovHN8744zkbhM2bYudU45BimGb" }
        market { public_key = variable.spcx_market.pda }
        quote_token_program { public_key = "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA" }
        base_token_program { public_key = "TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb" }
        system_program { public_key = std::decode_base58("11111111111111111111111111111111") }
    }
    signers = [signer.operator]
}

output "wsol_usdc_market" { value = variable.wsol_market.pda }
